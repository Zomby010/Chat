# MindMate web app. Copy to .env.local and fill in. These values are PUBLIC:
# Firebase web config is designed to ship in the browser bundle. Never put
# server secrets (service accounts, AI keys) in any VITE_ variable.

# Firebase console > Project settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Show the "Continue with Google" button (enable Google in Firebase Auth first).
VITE_ENABLE_GOOGLE_SIGNIN=true

# API base URL. Leave empty in development (Vite proxies /api to localhost:5000).
# In production set it to your deployed backend, e.g. https://mindmate-api.onrender.com
VITE_API_URL=

# Local development against the Firebase emulators (no real project needed):
# VITE_USE_FIREBASE_EMULATOR=true
# VITE_FIREBASE_API_KEY=demo-key
# VITE_FIREBASE_AUTH_DOMAIN=demo-mindmate.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=demo-mindmate
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
