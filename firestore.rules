rules_version = '2';

// MindMate stores wellbeing data, so the browser never reads or writes
// Firestore directly. Every request goes through the MindMate API, which
// verifies the user's Firebase ID token, validates input and scopes all
// access to users/{uid}. The API uses the Admin SDK, which is not subject to
// these rules.
//
// Denying all client access means that even a bug in the web app, or a
// leaked web config, cannot expose one user's data to another.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
