# ─────────────────────────────────────────────────────────────
# MindMate API configuration. Copy to backend/.env and fill in.
# Never commit backend/.env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when running behind a reverse proxy (Render, Railway, Nginx).
TRUST_PROXY=false

# ── Firebase Admin (required for sign-in and Firestore) ──────
# Firebase Console → Project settings → Service accounts → Generate new private key.
# Encode the downloaded JSON as one line:
#   macOS/Linux:  base64 -w0 service-account.json      (macOS: base64 -i file)
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
# ...or point to the JSON file instead (keep it outside the repo):
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_PROJECT_ID=

# "firestore" (default when credentials exist) or "memory" (data lost on restart).
# DATA_STORE=firestore

# Local development with the Firebase Emulator Suite (no credentials needed):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-mindmate

# ── AI companion (set ONE key) ───────────────────────────────
# Google Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OpenAI (paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Force a provider instead of auto-detecting from the keys above: gemini | openai | none
# AI_PROVIDER=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=600

# ── Other ────────────────────────────────────────────────────
# Crisis resources used when a user has not chosen a region:
# KE, NG, GB, US, CA, AU, IN or INTL.
DEFAULT_REGION=INTL
LOG_LEVEL=info
