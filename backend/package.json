{
  "name": "mindmate-api",
  "version": "2.0.0",
  "private": true,
  "description": "MindMate REST API: authentication, wellbeing data, crisis detection and AI chat",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "lint": "node --check src/server.js",
    "test:emulator": "firebase emulators:exec --project demo-mindmate --only auth,firestore --config ../firebase.json \"node --test test/firestore.integration.test.js\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
